{
  /* Vitest 테스트 파일 전용 타입 검사 설정이다. 앱 설정(tsconfig.app.json)을 그대로 물려받고 Node 타입만 더한다.
     테스트는 Node에서 실행되므로 문서 파일 읽기(node:fs) 같은 Node API를 쓸 수 있다.
     include에 src 전체를 두는 이유: 테스트가 앱 코드를 import하므로 함께 검사돼야 한다. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": []
}
