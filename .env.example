# 환경 변수 이름 목록(값은 비워 둔다). 복사해서 .env를 만들어 쓴다: Copy-Item .env.example .env
# - .env는 커밋하지 않는다(.gitignore 대상). 실제 비밀 값은 비밀번호 관리자 등 저장소 밖에 보관한다.
# - 로컬 DB·Redis 접속 정보(DB_NAME, DB_USERNAME, DB_PASSWORD, DB_PORT, REDIS_PORT)는 infra/docker-compose.yml에
#   기본값이 있어 비워 두면 기본값이 쓰인다. 바꿀 때만 채운다.
# - compose가 이 파일을 읽게 하려면: docker compose --env-file .env -f infra/docker-compose.yml up -d
# - VITE_ 접두사 변수는 브라우저에 노출되므로 비밀 값을 넣지 않는다.

# --- 앱 주소 ---
APP_FRONTEND_ORIGIN=
OAUTH2_REDIRECT_BASE_URL=

# --- 비밀 값(JWT_SECRET은 256비트 이상) ---
JWT_SECRET=
ADMIN_BATCH_TOKEN=
ORIGIN_SECRET=

# --- 데모 계정 로그인(둘 다 비우면 꺼짐, 하나만 넣으면 기동 실패, 비밀번호는 16자 이상) ---
DEMO_LOGIN_ID=
DEMO_LOGIN_PASSWORD=

# --- 데이터베이스 ---
DB_URL=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_PORT=

# --- Redis ---
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# --- 외부 연동 ---
TMDB_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 관리자 줄거리 번역(Gemini). 키가 비어 있으면 번역 기능만 꺼지고 앱은 기동된다
GEMINI_API_KEY=
# 기본값은 gemini-3.5-flash-lite. 바꿀 때만 값을 넣는다(빈 값으로 두지 말고 변수를 정의하지 않는다)
GEMINI_MODEL=
# 생각(thinking) 수준. 비워 두면 모델 기본값. 예: minimal 또는 low, 지원 값은 모델마다 다르다
GEMINI_THINKING_LEVEL=

# --- 메일 ---
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
APP_MAIL_PROVIDER=

# --- 프론트엔드(공개해도 되는 값만) ---
VITE_USE_MOCK=
