# 성능 측정(k6, Task 100)용 이미지. 운영(Cloudtype)은 자체 빌드라 이 파일을 쓰지 않는다.
# 먼저 `.\gradlew.bat bootJar -x test`로 jar를 만든 뒤 compose의 perf 프로필이 이 이미지를 빌드한다(빌드 맥락은 backend/, 이 파일은 backend/ 밖에 둔다).
# 같은 폴더의 Dockerfile.backend-perf.dockerignore가 이 빌드의 .dockerignore 역할을 한다(jar 하나만 맥락에 넣는다).
FROM eclipse-temurin:17-jre
WORKDIR /app
COPY build/libs/backend-0.0.1-SNAPSHOT.jar app.jar
# 힙 상한 등 JVM 옵션은 compose의 JAVA_TOOL_OPTIONS로 넣는다(운영과 같은 방식)
ENTRYPOINT ["java", "-jar", "app.jar"]
